{
  "openapi": "3.1.0",
  "info": {
    "title": "Memorable Platform API",
    "version": "1.0.0",
    "description": "RESTful API for Memorable memory management studio, memories, attachments, and markdown rendering."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "externalDocs": {
    "description": "Official Memorable Model Context Protocol (MCP) Server",
    "url": "https://github.com/leouofa/memorable"
  },
  "tags": [
    {
      "name": "Memories",
      "description": "Manage saved context and long-term memories"
    },
    {
      "name": "Search",
      "description": "Unified semantic and keyword vector search across memories"
    },
    {
      "name": "Attachments",
      "description": "Manage file attachments associated with memories"
    },
    {
      "name": "Markdown",
      "description": "Markdown rendering and preview services"
    },
    {
      "name": "System",
      "description": "System health, statistics, and platform metadata"
    }
  ],
  "paths": {
    "/api/v1/stats": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get system statistics",
        "description": "Returns counts of total memories, pinned memories, and attachments.",
        "responses": {
          "200": {
            "description": "Current platform statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get OpenAPI schema specification",
        "description": "Returns the complete OpenAPI 3.1.0 JSON schema for the Memorable API.",
        "responses": {
          "200": {
            "description": "OpenAPI schema document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/markdown/render": {
      "post": {
        "tags": [
          "Markdown"
        ],
        "summary": "Render Markdown text to HTML",
        "description": "Parses and sanitizes GitHub Flavored Markdown into safe HTML.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Raw markdown text to render"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rendered HTML result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "html": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/memories": {
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "List memories",
        "description": "Returns a paginated list of memories with optional filtering.",
        "parameters": [
          {
            "name": "pinned",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by pinned status"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search term across title and body"
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "semantic",
                "keyword"
              ],
              "default": "auto"
            },
            "description": "Search mode when q is provided"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of memories with pagination metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "memories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Memory"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Create a new memory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "memory": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      },
                      "pinned": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "title"
                    ]
                  }
                },
                "required": [
                  "memory"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetail"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/memories/reorder_pinned": {
      "patch": {
        "tags": [
          "Memories"
        ],
        "summary": "Reorder pinned memories",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "memory_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "memory_ids"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reordering successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/memories/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "Get memory details",
        "parameters": [
          {
            "name": "render_markdown",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Memory details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "patch": {
        "tags": [
          "Memories"
        ],
        "summary": "Update memory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "memory": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      },
                      "pinned": {
                        "type": "boolean"
                      },
                      "pinned_position": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Memories"
        ],
        "summary": "Delete memory",
        "responses": {
          "200": {
            "description": "Memory deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/memories/{id}/toggle_pin": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "patch": {
        "tags": [
          "Memories"
        ],
        "summary": "Toggle pinned state of memory",
        "responses": {
          "200": {
            "description": "Toggled pin status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "pinned": {
                      "type": "boolean"
                    },
                    "pinned_position": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "memory": {
                      "$ref": "#/components/schemas/Memory"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/memories/{id}/attachments": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "tags": [
          "Attachments"
        ],
        "summary": "List attachments of a memory",
        "responses": {
          "200": {
            "description": "List of file attachments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attachments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Attachment"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "post": {
        "tags": [
          "Attachments"
        ],
        "summary": "Attach files to memory",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                },
                "required": [
                  "files"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Files uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "attachments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Attachment"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/memories/{id}/attachments/{attachment_id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "attachment_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "delete": {
        "tags": [
          "Attachments"
        ],
        "summary": "Purge memory attachment",
        "responses": {
          "200": {
            "description": "Attachment removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Unified vector and keyword search across memories",
        "description": "Performs nearest-neighbor semantic search using pgvector cosine similarity or keyword search across memories.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query text"
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "semantic",
                "keyword"
              ],
              "default": "auto"
            },
            "description": "Search mode: semantic, keyword, or auto"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Maximum number of results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results ordered by relevance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "example": "Memory"
                          },
                          "score": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "example": 0.912345
                          },
                          "data": {
                            "$ref": "#/components/schemas/Memory"
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string"
                        },
                        "query": {
                          "type": "string"
                        },
                        "count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          }
        }
      }
    },
    "/api/v1/memories/{id}/neighbors": {
      "get": {
        "tags": [
          "Memories",
          "Search"
        ],
        "summary": "Find nearest semantic neighbors of a memory",
        "description": "Finds related memories using pgvector 1024-dimensional cosine distance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Memory ID"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of nearest neighbors to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Neighboring memories ordered by similarity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "memory": {
                      "$ref": "#/components/schemas/Memory"
                    },
                    "neighbors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "score": {
                            "type": "number",
                            "example": 0.892
                          },
                          "memory": {
                            "$ref": "#/components/schemas/Memory"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/memories/{id}/generate_embedding": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Generate or refresh vector embedding for a memory",
        "description": "Computes a 1024-dimensional embedding for the memory using the configured Ollama embedding model.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Memory ID"
          },
          {
            "name": "async",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Whether to enqueue as a background job"
          }
        ],
        "responses": {
          "200": {
            "description": "Embedding generated or enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "message": {
                      "type": "string"
                    },
                    "memory": {
                      "$ref": "#/components/schemas/Memory"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Memory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "pinned_position": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attachments_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "embedded": {
            "type": "boolean",
            "description": "Whether vector embedding is present"
          },
          "embedding_model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model used for embedding"
          },
          "embedded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when embedding was generated"
          }
        }
      },
      "MemoryDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Memory"
          },
          {
            "type": "object",
            "properties": {
              "rendered_html": {
                "type": "string"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            }
          }
        ]
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "byte_size": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total_memories": {
            "type": "integer"
          },
          "pinned_memories": {
            "type": "integer"
          },
          "total_attachments": {
            "type": "integer"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Bad request error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
